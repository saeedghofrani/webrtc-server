# Existing signaling configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Enable only with FCM credentials and a durable, private registry volume.
CALL_PUSH_ENABLED=false
# Optional exact host-proxy IPs when Docker changes the socket peer address.
# Use the actual server bridge gateway; never trust a whole private subnet.
TRUSTED_PROXY_IPS=
CALL_LINK_STORE=.data/call-links.json
# Private path on the host/container; do not put the actual key in this repository.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
